# Your Coston2 testnet wallet private key, used only to deploy contracts.
# Get test C2FLR from https://faucet.flare.network/ first.
# NEVER commit the real .env file (it's already gitignored).
PRIVATE_KEY=

# Optional — defaults to the public Coston2 RPC if unset.
COSTON2_RPC_URL=https://coston2-api.flare.network/ext/C/rpc

# Simulated TEE signer/decryptor keypair — generate with:
#   npx hardhat run scripts/generate-tee-key.cjs
# TEE_ADDRESS is the constructor arg for VeilBidding (public).
# TEE_PUBLIC_KEY is used by the frontend to ECIES-encrypt sealed bids (public).
# TEE_PRIVATE_KEY is only used by the demo "simulate TEE settlement" flow —
# in real FCC this key would never leave the attested enclave.
TEE_ADDRESS=
TEE_PUBLIC_KEY=
TEE_PRIVATE_KEY=

# Deployed contract address (filled in after running deploy:coston2) and the
# TEE public identifiers, exposed to the Vite frontend bundle.
VITE_VEILBIDDING_ADDRESS=
VITE_TEE_ADDRESS=
VITE_TEE_PUBLIC_KEY=
